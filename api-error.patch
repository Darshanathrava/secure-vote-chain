From ef536c0fe0c0c215d4698e9baccf12801c3e8939 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 10 Nov 2026 12:52:36 +0000
Subject: [PATCH] Show real API error on registration

---
 src/lib/api.ts             | 17 +++++++++++++++++
 src/pages/RegisterPage.tsx |  6 +++---
 2 files changed, 20 insertions(+), 3 deletions(-)

diff --git a/src/lib/api.ts b/src/lib/api.ts
index 1f7e8677..092ff35e 100644
--- a/src/lib/api.ts
+++ b/src/lib/api.ts
@@ -4,4 +4,21 @@ const api = axios.create({
   baseURL: import.meta.env.VITE_API_URL || 'http://localhost:1322/api',
 });
 
+/** Turn an axios error into a message that says what actually went wrong. */
+export function describeApiError(err: any, fallback = "Something went wrong"): string {
+  const serverMsg = err?.response?.data?.error;
+  if (serverMsg) return serverMsg;
+  const base = api.defaults.baseURL;
+  if (err?.response) {
+    return `Server at ${base} answered ${err.response.status} but not with an API error. It may be running the wrong service.`;
+  }
+  if (err?.request) {
+    if (/localhost|127\.0\.0\.1/.test(String(base)) && window.location.hostname !== "localhost") {
+      return `The site is calling ${base}. Set VITE_API_URL on Vercel to your Render API URL and redeploy.`;
+    }
+    return `Cannot reach the server at ${base}. It may be asleep, down, or blocking this site (CORS).`;
+  }
+  return err?.message || fallback;
+}
+
 export default api;
diff --git a/src/pages/RegisterPage.tsx b/src/pages/RegisterPage.tsx
index 150e98f5..9205f105 100644
--- a/src/pages/RegisterPage.tsx
+++ b/src/pages/RegisterPage.tsx
@@ -8,7 +8,7 @@ import { Card, CardContent, CardHeader, CardTitle, CardDescription } from "@/com
 import { useToast } from "@/hooks/use-toast";
 import { useFingerprint, captureWithDetails, getDeviceInfo, type FingerprintScan } from "@/hooks/useFingerprint";
 import FingerprintDevicePanel from "@/components/FingerprintDevicePanel";
-import api from "@/lib/api";
+import api, { describeApiError } from "@/lib/api";
 
 type Step = "personal" | "biometric" | "review";
 
@@ -105,7 +105,7 @@ export default function RegisterPage() {
       } catch (fpErr: any) {
         toast({
           title: "Account created — fingerprint incomplete",
-          description: fpErr?.response?.data?.error || fpErr.message || "Make sure the Mantra RD Service is running.",
+          description: describeApiError(fpErr, "Make sure the Mantra RD Service is running."),
           variant: "destructive",
         });
       }
@@ -114,7 +114,7 @@ export default function RegisterPage() {
     } catch (err: any) {
       toast({
         title: "Registration Failed",
-        description: err?.response?.data?.error || "Something went wrong",
+        description: describeApiError(err),
         variant: "destructive"
       });
     } finally {
