{
  "name": "admin-project",
  "version": "1.0.0",
  "description": "This project is a web application that allows users to vote for their preferred candidates in an election. The project uses MongoDB for database management and has three collections for candidates, elections, and users.",
  "main": "index.js",
  "scripts": {
    "dev": "npx concurrently \"npm run backend\" \"npm run frontend\"",
    "frontend": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "legacy-frontend": "cd client && npm start",
    "legacy-frontend:build": "cd client && npm run build",
    "backend": "cd server && npm run dev",
    "newBackend": "cd server && npm install && npm run dev"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
