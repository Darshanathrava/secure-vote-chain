 render.yaml                             |   4 -
 server/.env                             |  11 --
 server/.env.example                     |   2 -
 server/Controller/AuthController.js     |   2 +-
 server/Controller/voteController.js     |   4 +-
 server/Controller/webauthnController.js | 195 ------------------------
 server/Models/User.js                   |   6 -
 server/Routes/webauthnRoute.js          |  15 --
 server/main.js                          |   2 -
 10 files changed, 5 insertions(+), 242 deletions(-)
 delete mode 100644 server/.env
