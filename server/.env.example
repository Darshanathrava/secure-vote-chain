MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/securevotechain
JWT_SECRET=change_me_to_a_long_random_string
PORT=1322

# Comma-separated browser origins allowed to call this API
FRONTEND_ORIGIN=http://localhost:5173,https://your-app.vercel.app

# WebAuthn — must match the frontend hostname (no protocol on RP_ID)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# Python used by DeepFace face verification (optional if python3 is on PATH)
PYTHON_PATH=/usr/bin/python3

# Optional email notifications
EMAIL=
EMAILPASSWORD=
