# Frontend (Vite) — used at build time on Vercel
# Local default is http://localhost:1322/api when unset
VITE_API_URL=https://your-render-service.onrender.com/api

# Render backend: comma-separated browser origins allowed to call the API
# Example: https://your-app.vercel.app,https://your-app-git-main.vercel.app,http://localhost:5173
FRONTEND_ORIGIN=https://your-app.vercel.app,http://localhost:5173
